---
// src/components/Hero.astro

const stats = [
  {
    value: "15+",
    label: "Anni di Esperienza",
    iconPath: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
  },
  {
    value: "€40M+",
    label: "Valore Cantieri Gestiti",
    iconPath: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M12 16V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
  },
  {
    value: "500+",
    label: "Progetti Chiavi in Mano",
    iconPath: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
  },
  {
    value: "99%",
    label: "Clienti Soddisfatti",
    iconPath: "M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
  }
];
---

<section id="home" class="w-full min-h-screen lg:h-screen p-[10px] bg-slate-50 relative overflow-hidden flex flex-col font-['Inter']">
  
  <div class="relative w-full flex-1 rounded-2xl overflow-hidden bg-slate-900 border-4 border-white shadow-xl flex flex-col justify-between p-6 sm:p-12 lg:p-16">
    
    <!-- Background Immagine (Animata con un micro-zoom delicato) -->
    <div class="absolute inset-0 z-0 overflow-hidden rounded-xl">
      <img 
        src="https://images.unsplash.com/photo-1600585154526-990dced4db0d?auto=format&fit=crop&w=1920&q=80" 
        alt="Progettazione Edilizia Moderna" 
        class="w-full h-full object-cover object-center lg:object-[right_center] opacity-35 animate-hero-zoom"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/85 via-slate-900/60 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/50 via-transparent to-transparent"></div>
    </div>

    <!-- TESTI (Animati in entrata a cascata senza muovere il layout) -->
    <div class="relative w-full max-w-7xl mx-auto z-10 my-auto pt-8 lg:pt-0">
      <div class="max-w-xl lg:max-w-2xl">
        <span class="animate-reveal inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] sm:text-xs font-semibold  text-lime-400 mb-4 uppercase tracking-wider">
          Unico Interlocutore Chiavi in Mano
        </span>
        
        <h1 class="animate-reveal [animation-delay:150ms] text-2xl sm:text-4xl md:text-6xl font-bold tracking-tight text-white mb-4 leading-[1.2]">
          Soluzioni Integrate per l'Edilizia e la Gestione Immobiliare
        </h1>
        
        <p class="animate-reveal [animation-delay:300ms] text-xs sm:text-sm md:text-base text-slate-300 mb-8 leading-relaxed max-w-lg">
          Dalla progettazione urbanistica alla cantieristica, fino al brokerage logistico. Semplifichiamo la gestione tecnica e operativa per privati, aziende e fondi immobiliari.
        </p>
        
        <div class="animate-reveal [animation-delay:450ms] flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a 
            href="#contatti" 
            class="inline-flex items-center justify-center px-6 py-3 rounded-full font-bold bg-lime-400 text-slate-950 hover:bg-lime-300 shadow-lg shadow-lime-500/10 transition-all text-xs sm:text-sm text-center hover:-translate-y-0.5"
          >
            Richiedi una consulenza
          </a>
          <a 
            href="#servizi" 
            class="inline-flex items-center justify-center px-6 py-3 rounded-full font-semibold bg-white/10 text-white hover:bg-white/20 border border-white/10 backdrop-blur-sm transition-all text-xs sm:text-sm text-center"
          >
            Il Nostro Approccio
          </a>
        </div>
      </div>
    </div>

    <!-- BANNER CONTATORI (Resta fermo nella sua posizione esatta, ma sfuma verso l'alto con eleganza) -->
    <div class="animate-reveal-up [animation-delay:600ms] relative w-full max-w-7xl mx-auto z-10 mt-8 lg:mt-0">
      <div class="max-w-[310px] sm:max-w-none mx-auto bg-white/95 lg:bg-white rounded-2xl lg:rounded-full shadow-lg p-6 lg:py-4 lg:px-10">
        
        <div class="flex flex-col sm:grid sm:grid-cols-2 lg:grid-cols-4 gap-y-6 sm:gap-6 lg:gap-y-0 lg:divide-x lg:divide-slate-100">
          {stats.map((stat) => (
            <div class="flex items-center gap-4 lg:pl-6 first:pl-0">
              <div class="w-10 h-10 rounded-full bg-lime-200 text-emerald-950 flex items-center justify-center shrink-0 shadow-sm transition-transform duration-300 hover:scale-110">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={stat.iconPath} />
                </svg>
              </div>
              
              <div class="flex flex-col">
                <div class="text-base sm:text-lg lg:text-xl font-black text-slate-800 tracking-tight leading-none mb-0.5">
                  {stat.value}
                </div>
                <div class="text-xs text-slate-500 font-medium tracking-wide leading-tight">
                  {stat.label}
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>

  </div>
  
</section>

<style>
  /* Forza l'applicazione delle animazioni legandole alle classi di Tailwind */
  .animate-fluid-reveal {
    opacity: 0;
    animation: fluidRevealEffect 1.4s cubic-bezier(0.19, 1, 0.22, 1) forwards;
  }

  .animate-elastic-up {
    opacity: 0;
    animation: elasticUpEffect 1.6s cubic-bezier(0.175, 0.885, 0.32, 1.1) forwards;
  }

  .animate-cinematic-bg {
    animation: cinematicEffect 12s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite alternate;
  }

  /* KEYFRAMES (Assicurati che siano scritti esattamente così) */
  @keyframes fluidRevealEffect {
    0% {
      opacity: 0;
      transform: translateY(25px) scale(0.99);
      filter: blur(4px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  @keyframes elasticUpEffect {
    0% {
      opacity: 0;
      transform: translateY(40px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes cinematicEffect {
    0% {
      transform: scale(1.04) translateX(-10px);
    }
    100% {
      transform: scale(1.01) translateX(10px);
    }
  }
</style>