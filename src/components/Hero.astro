---
// src/components/Hero.astro
import { Image } from 'astro:assets';
import bgImage from '../assets/images/bg-hero.jpg';
const stats = [
  {
    value: "24/7",
    label: "Reperibilità e Assistenza",
    iconPath: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
  },
  {
    value: "0 €",
    label: "Sopralluogo e Preventivo",
    iconPath: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
  },
  {
    value: "100%",
    label: "Chiavi in Mano a Verona",
    iconPath: "M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 0121 9z"
  },
  {
    value: "1 Unico",
    label: "Interlocutore e Referente",
    iconPath: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
  }
];
---

<section id="home" class="w-full min-h-screen lg:h-screen p-[10px] bg-slate-100 relative overflow-hidden flex flex-col font-['Inter']">
  
  <div class="relative w-full flex-1 rounded-2xl overflow-hidden bg-slate-900 border-4 border-white shadow-xl flex flex-col justify-between p-6 sm:p-12 lg:p-16">
    
    <!-- Background Immagine (Animata con un micro-zoom delicato) -->
    <div class="absolute inset-0 z-0 overflow-hidden rounded-xl">
      <Image src={bgImage} alt="Ristrutturazioni Verona Vega Costruzioni" class="w-full h-full object-cover opacity-40 animate-hero-zoom" />
      <div class="absolute inset-0 bg-gradient-to-r from-blue-950/90 via-slate-900/75 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
    </div>

    <!-- TESTI -->
    <div class="relative w-full max-w-7xl mx-auto z-10 my-auto pt-8 lg:pt-0">
      <div class="max-w-xl lg:max-w-2xl">
        
        <!-- Badge identificativo -->
        <div class="animate-reveal inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-500/20 border border-orange-500/30 text-orange-400 text-xs font-semibold uppercase tracking-wider mb-4 backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
          Impresa Edile a Verona e Provincia
        </div>

        <h1 class="animate-reveal [animation-delay:150ms] text-2xl sm:text-4xl md:text-6xl font-extrabold tracking-tight text-white mb-4 leading-[1.15]">
          Ristrutturazioni Chiavi in Mano <span class="text-orange-500">Senza Pensieri</span>
        </h1>
        
        <p class="animate-reveal [animation-delay:300ms] text-xs sm:text-sm md:text-base text-slate-300 mb-8 leading-relaxed max-w-lg">
          Un’unica impresa coordinata per la ristrutturazione e costruzione di case, appartamenti, ville, condomini e uffici. Materiali di prima scelta, costi certi e consegna nei tempi concordati.
        </p>
        
        <div class="animate-reveal [animation-delay:450ms] flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a 
            href="#contatti" 
            class="inline-flex items-center justify-center px-6 py-3 rounded-full font-bold bg-orange-600 text-white hover:bg-orange-500 shadow-lg shadow-orange-600/25 transition-all text-xs sm:text-sm text-center hover:-translate-y-0.5"
          >
            Sopralluogo e Preventivo Gratuito
          </a>
          <a 
            href="tel:0452220703" 
            class="inline-flex items-center justify-center px-6 py-3 rounded-full font-semibold bg-white/10 text-white hover:bg-white/20 border border-white/15 backdrop-blur-sm transition-all text-xs sm:text-sm text-center gap-2"
          >
            <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Tel. 045 2220703
          </a>
        </div>
      </div>
    </div>

    <!-- BANNER VANTAGGI E CONTATORI -->
    <div class="animate-reveal-up [animation-delay:600ms] relative w-full max-w-7xl mx-auto z-10 mt-8 lg:mt-0">
      <div class="max-w-[500px] sm:max-w-none mx-auto bg-white/95 lg:bg-white rounded-2xl lg:rounded-full shadow-xl p-6 lg:py-4 lg:px-10 border border-slate-100">
        
        <div class="flex flex-col sm:grid sm:grid-cols-2 lg:grid-cols-4 gap-y-6 sm:gap-6 lg:gap-y-0 lg:divide-x lg:divide-slate-200">
          {stats.map((stat) => (
            <div class="flex items-center gap-4 lg:pl-6 first:pl-0">
              <div class="w-10 h-10 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center shrink-0 shadow-sm transition-transform duration-300 hover:scale-110">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={stat.iconPath} />
                </svg>
              </div>
              
              <div class="flex flex-col">
                <div class="text-base sm:text-lg lg:text-xl font-black text-slate-900 tracking-tight leading-none mb-0.5">
                  {stat.value}
                </div>
                <div class="text-xs text-slate-600 font-medium tracking-wide leading-tight">
                  {stat.label}
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>

  </div>
  
</section>

<style>
  .animate-reveal {
    opacity: 0;
    animation: fluidRevealEffect 1.2s cubic-bezier(0.19, 1, 0.22, 1) forwards;
  }

  .animate-reveal-up {
    opacity: 0;
    animation: elasticUpEffect 1.4s cubic-bezier(0.175, 0.885, 0.32, 1.1) forwards;
  }

  .animate-hero-zoom {
    animation: zoomEffect 14s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite alternate;
  }

  @keyframes fluidRevealEffect {
    0% {
      opacity: 0;
      transform: translateY(20px);
      filter: blur(4px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @keyframes elasticUpEffect {
    0% {
      opacity: 0;
      transform: translateY(30px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes zoomEffect {
    0% {
      transform: scale(1);
    }
    100% {
      transform: scale(1.06);
    }
  }
</style>