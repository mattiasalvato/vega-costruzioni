---
// src/components/Testimonials.astro

const reviews = [
  {
    name: "Marco Valenti",
    role: "Proprietario Immobiliare",
    image: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&h=150&q=80",
    text: "Avevo la necessità di ristrutturare una palazzina e sanare due vecchie difformità urbanistiche. Edilpartner ha risolto tutto: dalle pratiche in comune al coordinamento del cantiere, fino al trasloco finale degli inquilini. Unici."
  },
  {
    name: "Ing. Daniela Serra",
    role: "Asset Manager SGR",
    image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=150&h=150&q=80",
    text: "Collaboriamo con loro per le attività di Due Diligence tecnica sui nostri stabili prima delle acquisizioni del fondo. Massima precisione nei computi metrici, report chiari e tempi di risposta rapidissimi."
  },
  {
    name: "Arch. Riccardo Riva",
    role: "Sviluppatore Immobiliare",
    image: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=150&h=150&q=80",
    text: "Il miglior General Broker sul mercato. Subappalti logistici fluidi, sanno sempre come risolvere imprevisti di cantiere e hanno un approccio orientato alla massimizzazione del ROI."
  }
];
---

<section id="testimonianze" class="fade-in-up delay-300 py-20 bg-white font-['Inter'] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 1. INTESTAZIONE REVIEWS -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="inline-block px-4 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-800 uppercase tracking-wider mb-4">
        Testimonianze
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-950 tracking-tight mb-4 leading-tight">
        Cosa Dicono i Clienti dei Nostri <span class="text-lime-500 font-black">Risultati</span>
      </h2>
    </div>

    <!-- 2. SLIDER TESTIMONIANZE -->
    <div class="relative max-w-5xl mx-auto mb-20 px-2">
      <!-- Container delle slide -->
      <div id="testimonial-track" class="flex gap-6 overflow-x-auto snap-x snap-mandatory scrollbar-none scroll-smooth pb-4">
        {reviews.map((review) => (
          <div class="min-w-full md:min-w-[calc(50%-12px)] snap-start bg-slate-50/70 border border-slate-100/50 p-8 sm:p-10 rounded-[2rem] flex flex-col justify-between shadow-sm transition-all duration-300">
            <div>
              <!-- Stelline verdi (Fundex Style) -->
              <div class="flex gap-1 mb-6 text-lime-500">
                {[...Array(5)].map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
              
              <p class="text-sm sm:text-base text-slate-600 leading-relaxed italic mb-8">
                "{review.text}"
              </p>
            </div>

            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full overflow-hidden p-[2px] bg-lime-300 ring-2 ring-slate-100">
                <img src={review.image} alt={review.name} class="w-full h-full object-cover rounded-full" />
              </div>
              <div>
                <h4 class="text-sm font-extrabold text-slate-900 leading-none mb-1">{review.name}</h4>
                <p class="text-xs text-slate-400 font-medium">{review.role}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Frecce di Navigazione dello Slider -->
      <div class="flex justify-center gap-3 mt-6">
        <button id="slide-prev" class="w-10 h-10 rounded-full bg-slate-100 hover:bg-lime-200 text-slate-800 hover:text-emerald-950 flex items-center justify-center transition-colors shadow-sm" aria-label="Recensione precedente">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button id="slide-next" class="w-10 h-10 rounded-full bg-slate-100 hover:bg-lime-200 text-slate-800 hover:text-emerald-950 flex items-center justify-center transition-colors shadow-sm" aria-label="Recensione successiva">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- 3. BANNER CTA FULL WIDTH CON PADDING 10PX E ROUNDED 16PX (Stile Hero) -->
  <div class="w-full px-[10px] bg-white">
    <div class="relative w-full rounded-2xl overflow-hidden bg-slate-900 border-4 border-white shadow-xl min-h-[380px] flex items-center p-6 sm:p-12 lg:p-16">
      
      <!-- Sfondo Immagine del Banner -->
      <div class="absolute inset-0 z-0">
        <img 
          src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=80" 
          alt="Incontro con investitori" 
          class="w-full h-full object-cover opacity-25 object-center"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/80 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent"></div>
      </div>

      <!-- Contenuto del Banner -->
      <div class="relative z-10 max-w-xl pl-0 sm:pl-30">
        <h3 class="text-2xl sm:text-5xl font-bold text-white mb-4 tracking-tight leading-tight">
          Inizia a Strutturare la Tua Strategia Edilizia ed Immobiliare
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 mb-8 leading-relaxed">
          Che tu sia un investitore privato o un fondo istituzionale, mettiamo a disposizione un team tecnico integrato pronto a darti risposte certe.
        </p>
        
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a 
            href="#contatti" 
            class="inline-flex items-center justify-center px-6 py-3 rounded-full font-bold bg-lime-400 text-slate-950 hover:bg-lime-300 shadow-md text-xs sm:text-sm text-center transition-all"
          >
            Consulenza Gratuita
          </a>
          <a 
            href="#servizi" 
            class="inline-flex items-center justify-center px-6 py-3 rounded-full font-semibold bg-white/10 text-white hover:bg-white/20 border border-white/10 backdrop-blur-sm text-xs sm:text-sm text-center transition-all"
          >
            Il Nostro Approccio
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- SCRIPT PER IL FUNZIONAMENTO DELLO SLIDER -->
<script>
  const track = document.getElementById('testimonial-track');
  const prevBtn = document.getElementById('slide-prev');
  const nextBtn = document.getElementById('slide-next');

  if (track && prevBtn && nextBtn) {
    nextBtn.addEventListener('click', () => {
      // Sposta in avanti del valore di una card intera
      const cardWidth = track.firstElementChild ? (track.firstElementChild as HTMLElement).offsetWidth + 24 : 300;
      track.scrollLeft += cardWidth;
    });

    prevBtn.addEventListener('click', () => {
      // Sposta indietro
      const cardWidth = track.firstElementChild ? (track.firstElementChild as HTMLElement).offsetWidth + 24 : 300;
      track.scrollLeft -= cardWidth;
    });
  }
</script>

<style>
  /* Utility per nascondere la scrollbar nativa ma mantenere lo scorrimento */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>