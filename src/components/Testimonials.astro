---
// src/components/Testimonials.astro

const reviews = [
  {
    name: "Marco Valenti",
    role: "Proprietario ad San Giovanni Lupatoto (VR)",
    image: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&h=150&q=80",
    text: "Dovevo ristrutturare completamente l'appartamento di famiglia. Avere un'unica impresa come Vega Costruzioni che gestisce sia le opere murarie sia gli impianti ha ridotto notevolmente costi e tempi. Risultato impeccabile!"
  },
  {
    name: "Elena Rossini",
    role: "Proprietaria a Verona Centro",
    image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=150&h=150&q=80",
    text: "Abbiamo rifatto il bagno e sostituito la pavimentazione. Il cantiere è stato gestito con la massima pulizia, puntualità nella consegna e materiali di ottima qualità. Consulente sempre reperibile per ogni chiarimento."
  },
  {
    name: "Geom. Riccardo Riva",
    role: "Amministratore Condominiale - Verona",
    image: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=150&h=150&q=80",
    text: "Collaboriamo con la cooperativa VEGA per la manutenzione e il rifacimento di tetti e cappotti termici nei condomini che gestisco. Grande serietà, coordinamento del personale esperto e cantieri a norma di sicurezza."
  }
];
---

<section id="testimonianze" class="fade-in-up delay-300 py-20 bg-slate-50 font-['Inter'] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 1. INTESTAZIONE REVIEWS -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold bg-orange-100 text-orange-700 uppercase tracking-wider mb-4 border border-orange-200">
        Testimonianze
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4 leading-tight">
        Cosa Dicono i Nostri <span class="text-orange-600 font-black">Clienti a Verona</span>
      </h2>
      <p class="text-sm sm:text-base text-slate-600">
        La soddisfazione dei nostri clienti è la testimonianza della qualità dei nostri lavori di ristrutturazione e costruzione.
      </p>
    </div>

    <!-- 2. SLIDER TESTIMONIANZE -->
    <div class="relative max-w-5xl mx-auto mb-20 px-2">
      <!-- Container delle slide -->
      <div id="testimonial-track" class="flex gap-6 overflow-x-auto snap-x snap-mandatory scrollbar-none scroll-smooth pb-4">
        {reviews.map((review) => (
          <div class="min-w-full md:min-w-[calc(50%-12px)] snap-start bg-white border border-slate-200/80 p-8 sm:p-10 rounded-[2rem] flex flex-col justify-between shadow-sm transition-all duration-300 hover:border-orange-200">
            <div>
              <!-- Stelline Arancioni -->
              <div class="flex gap-1 mb-6 text-orange-500">
                {[...Array(5)].map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
              
              <p class="text-sm sm:text-base text-slate-600 leading-relaxed italic mb-8">
                "{review.text}"
              </p>
            </div>

            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full overflow-hidden p-[2px] bg-orange-400 ring-2 ring-slate-100">
                <img src={review.image} alt={review.name} class="w-full h-full object-cover rounded-full" />
              </div>
              <div>
                <h4 class="text-sm font-extrabold text-slate-900 leading-none mb-1">{review.name}</h4>
                <p class="text-xs text-slate-500 font-medium">{review.role}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Frecce di Navigazione dello Slider -->
      <div class="flex justify-center gap-3 mt-6">
        <button id="slide-prev" class="w-10 h-10 rounded-full bg-white hover:bg-orange-500 text-slate-800 hover:text-white flex items-center justify-center transition-colors shadow-sm border border-slate-200" aria-label="Recensione precedente">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button id="slide-next" class="w-10 h-10 rounded-full bg-white hover:bg-orange-500 text-slate-800 hover:text-white flex items-center justify-center transition-colors shadow-sm border border-slate-200" aria-label="Recensione successiva">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- 3. BANNER CTA FULL WIDTH -->
  <div class="w-full px-[10px]">
    <div class="relative w-full rounded-2xl overflow-hidden bg-blue-950 border-4 border-white shadow-xl min-h-[380px] flex items-center p-6 sm:p-12 lg:p-16">
      
      <!-- Sfondo Immagine del Banner -->
      <div class="absolute inset-0 z-0">
        <img 
          src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=80" 
          alt="Vega Costruzioni Ristrutturazioni" 
          class="w-full h-full object-cover opacity-20 object-center"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-blue-950 via-blue-950/90 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent"></div>
      </div>

      <!-- Contenuto del Banner -->
      <div class="relative z-10 max-w-xl">
        <h3 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-white mb-4 tracking-tight leading-tight">
          Pianifica la Tua Ristrutturazione a Verona
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 mb-8 leading-relaxed">
          Richiedi oggi stesso una consulenza o un sopralluogo gratuito. Il nostro team valuterà attentamente le tue esigenze per offrirti il miglior preventivo.
        </p>
        
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a 
            href="#contatti" 
            class="inline-flex items-center justify-center px-6 py-3.5 rounded-full font-bold bg-orange-600 text-white hover:bg-orange-500 shadow-lg shadow-orange-600/30 text-xs sm:text-sm text-center transition-all"
          >
            Sopralluogo Gratuito
          </a>
          <a 
            href="tel:0452220703" 
            class="inline-flex items-center justify-center px-6 py-3.5 rounded-full font-semibold bg-white/10 text-white hover:bg-white/20 border border-white/15 backdrop-blur-sm text-xs sm:text-sm text-center transition-all gap-2"
          >
            <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Tel. 045 2220703
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- SCRIPT PER IL FUNZIONAMENTO DELLO SLIDER -->
<script>
  const track = document.getElementById('testimonial-track');
  const prevBtn = document.getElementById('slide-prev');
  const nextBtn = document.getElementById('slide-next');

  if (track && prevBtn && nextBtn) {
    nextBtn.addEventListener('click', () => {
      const cardWidth = track.firstElementChild ? (track.firstElementChild as HTMLElement).offsetWidth + 24 : 300;
      track.scrollLeft += cardWidth;
    });

    prevBtn.addEventListener('click', () => {
      const cardWidth = track.firstElementChild ? (track.firstElementChild as HTMLElement).offsetWidth + 24 : 300;
      track.scrollLeft -= cardWidth;
    });
  }
</script>

<style>
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>