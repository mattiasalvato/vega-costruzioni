---
// src/components/About.astro
---

<section id="chi-siamo" class="fade-in-up delay-300 py-20 lg:py-24 bg-slate-50 font-['Inter'] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Testata Sezione -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold bg-orange-100 text-orange-700 uppercase tracking-wider mb-4 border border-orange-200">
        Chi Siamo
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4 leading-tight">
        L'Unica Impresa per le Tue <span class="text-orange-600 font-black">Ristrutturazioni a Verona</span>
      </h2>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        Vega Costruzioni è un'impresa edile specializzata nella ristrutturazione di case, appartamenti, ville, condomini, negozi e uffici a Verona e provincia. Offriamo anche la costruzione di nuovi edifici con consegna chiavi in mano.
      </p>
    </div>

    <!-- Griglia Schede / Layout Visivo -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch lg:px-6">
      
      <!-- Immagine Sinistra -->
      <div class="rounded-2xl overflow-hidden shadow-md aspect-[4/3] md:aspect-auto flex border border-slate-200">
        <img 
          src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=800&q=80" 
          alt="Cantiere e direzione lavori Vega Costruzioni" 
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Card Centrale In Evidenza (Brand Statement) -->
      <div class="bg-blue-900 text-white rounded-2xl p-8 sm:p-10 flex flex-col justify-between shadow-xl relative min-h-[380px] md:min-h-[420px] md:-translate-y-4 z-10 transition-transform duration-300 border border-blue-800">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 bg-orange-600 rounded-lg flex items-center justify-center text-white font-black text-base shadow-sm">
            V
          </div>
          <span class="text-sm font-bold tracking-tight text-slate-100 uppercase">Vega Costruzioni</span>
        </div>

        <div class="my-auto">
          <p class="text-lg sm:text-xl font-bold leading-snug tracking-tight text-slate-100">
            “Quando le ristrutturazioni sono eseguite da un’unica impresa, il costo è più contenuto e i tempi si riducono grazie al coordinamento diretto di tutto il personale.”
          </p>
        </div>

        <div class="border-t border-blue-800/80 pt-4 mt-4">
          <p class="text-xs font-semibold uppercase tracking-wider text-orange-400">
            — Perché Scegliere un Interlocutore Unico
          </p>
        </div>
      </div>

      <!-- Immagine Destra -->
      <div class="rounded-2xl overflow-hidden shadow-md aspect-[4/3] md:aspect-auto flex border border-slate-200">
        <img 
          src="https://images.unsplash.com/photo-1581094794329-c8112a89af12?auto=format&fit=crop&w=800&q=80" 
          alt="Lavori di rifinitura e materiali di qualità" 
          class="w-full h-full object-cover"
        />
      </div>

    </div>

    <!-- Bottone Call-To-Action -->
    <div class="text-center mt-12 md:mt-16">
      <a 
        href="#servizi" 
        class="inline-flex items-center justify-center px-8 py-3.5 rounded-full font-bold bg-orange-600 text-white hover:bg-orange-500 shadow-md shadow-orange-600/20 transition-all text-xs sm:text-sm tracking-wide gap-2"
      >
        <span>Esplora i Nostri Servizi</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </div>

  </div>
</section>