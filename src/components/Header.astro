---
// src/components/Header.astro
const menuLinks = [
  { text: "Home", href: "#home" },
  { text: "Chi Siamo", href: "#chi-siamo" },
  { text: "Servizi", href: "#servizi" },
  { text: "Perché Sceglierci", href: "#why-choose-us" },
  { text: "Testimonianze", href: "#testimonianze" },
  { text: "FAQ", href: "#faq" },
];
---

<header id="main-header" class="fixed top-0 left-0 w-full z-50 px-6 sm:px-10 lg:px-14 font-['Inter'] transition-all duration-300 ease-in-out pt-[10px]">
  <div id="header-inner" class="max-w-7xl mx-auto h-20 flex items-center justify-between border-b border-white/10 transition-all duration-300 relative z-50">
    
    <!-- Logo Vega Costruzioni -->
    <a href="#home" class="flex items-center gap-2.5 group shrink-0">
      <span class="w-9 h-9 bg-orange-600 rounded-lg flex items-center justify-center text-white font-black text-lg transition-transform group-hover:scale-105 shadow-md shadow-orange-600/30">V</span>
      <span class="text-lg font-bold tracking-tight text-white uppercase">VEGA <span class="text-orange-500 font-extrabold">COSTRUZIONI</span></span>
    </a>

    <!-- Navigazione Desktop -->
    <nav class="hidden md:flex items-center gap-6 lg:gap-8">
      {menuLinks.map(link => (
        <a 
          href={link.href} 
          class="text-xs font-bold uppercase tracking-wider text-white/90 hover:text-orange-400 transition-colors py-2"
        >
          {link.text}
        </a>
      ))}
    </nav>

    <!-- Pulsante Call To Action Desktop -->
    <div class="hidden md:flex shrink-0">
      <a 
        href="#contatti" 
        class="inline-flex items-center justify-center px-6 py-2.5 rounded-full text-xs font-bold bg-orange-600 text-white hover:bg-orange-500 shadow-md shadow-orange-600/25 transition-all hover:-translate-y-0.5"
      >
        Preventivo Gratuito
      </a>
    </div>

    <!-- Bottone Menu Mobile (Hamburger / X) -->
    <button 
      id="menu-btn" 
      class="md:hidden relative z-50 p-2 text-white hover:text-orange-400 focus:outline-none transition-colors" 
      aria-label="Toggle Menu"
    >
      <!-- Icona Burger -->
      <svg id="icon-burger" class="w-7 h-7 block transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <!-- Icona X di chiusura -->
      <svg id="icon-close" class="w-7 h-7 hidden transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- MENU MOBILE FULL PAGE -->
  <div 
    id="mobile-menu" 
    class="fixed inset-0 z-40 bg-blue-950/98 backdrop-blur-xl flex flex-col justify-between p-6 sm:p-10 pt-28 pb-10 transition-all duration-500 ease-out opacity-0 pointer-events-none -translate-y-4 md:hidden overflow-y-auto"
  >
    <!-- Sfondo decorativo a griglia -->
    <div class="absolute inset-0 bg-[radial-gradient(#ea580c_1px,transparent_1px)] [background-size:24px_24px] opacity-[0.04] pointer-events-none"></div>

    <!-- Elenco Voci di Navigazione -->
    <div class="relative z-10 my-auto space-y-3">
      {menuLinks.map((link, index) => (
        <a 
          href={link.href} 
          class="mobile-nav-link block text-2xl sm:text-3xl font-extrabold uppercase tracking-tight text-white hover:text-orange-500 transition-all duration-300 transform translate-y-4 opacity-0 border-b border-white/5 pb-3"
          style={`transition-delay: ${index * 60 + 100}ms;`}
        >
          {link.text}
        </a>
      ))}
    </div>

    <!-- Sezione Inferiore Menu: CTA & Contatti -->
    <div class="relative z-10 pt-6 border-t border-white/10 space-y-4">
      <a 
        href="#contatti" 
        class="mobile-nav-link block text-center w-full bg-orange-600 text-white font-bold py-3.5 rounded-full text-xs uppercase tracking-wider shadow-lg shadow-orange-600/30 hover:bg-orange-500 transition-all transform translate-y-4 opacity-0"
        style={`transition-delay: ${menuLinks.length * 60 + 100}ms;`}
      >
        Richiedi Preventivo Gratuito
      </a>

      <!-- Contatti rapidi -->
      <div class="flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-slate-300 pt-2">
        <a href="tel:0452220703" class="hover:text-orange-400 transition-colors flex items-center gap-2">
          <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Tel. 045 2220703
        </a>
        <a href="mailto:info@ristrutturazioniveronaok.it" class="hover:text-orange-400 transition-colors flex items-center gap-2">
          <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          info@ristrutturazioniveronaok.it
        </a>
      </div>
    </div>

  </div>
</header>

<script>
  const header = document.getElementById('main-header');
  const innerContainer = document.getElementById('header-inner');
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconBurger = document.getElementById('icon-burger');
  const iconClose = document.getElementById('icon-close');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  let lastScrollY = window.scrollY;
  let isMenuOpen = false;

  // Gestione dello Sfondo Dinamico Header allo scorrimento
  window.addEventListener('scroll', () => {
    if (!header || !innerContainer || isMenuOpen) return;

    const currentScrollY = window.scrollY;

    if (currentScrollY > 50) {
      header.classList.remove('pt-[10px]');
      header.classList.add('bg-blue-950/95', 'backdrop-blur-md', 'shadow-md');
      innerContainer.classList.remove('border-b', 'border-white/10', 'h-20');
      innerContainer.classList.add('h-16');
    } else {
      header.classList.add('pt-[10px]');
      header.classList.remove('bg-blue-950/95', 'backdrop-blur-md', 'shadow-md');
      innerContainer.classList.add('border-b', 'border-white/10', 'h-20');
      innerContainer.classList.remove('h-16');
    }

    if (currentScrollY > lastScrollY && currentScrollY > 400) {
      header.classList.add('-translate-y-full');
    } else {
      header.classList.remove('-translate-y-full');
    }

    lastScrollY = currentScrollY;
  });

  // Funzioni di Apertura/Chiusura Menu Mobile
  function openMobileMenu() {
    isMenuOpen = true;
    mobileMenu?.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-4');
    mobileMenu?.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
    
    iconBurger?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    
    document.body.style.overflow = 'hidden'; // Blocca lo scroll del body

    // Attiva le transizioni scaglionate sui link
    navLinks.forEach((link) => {
      link.classList.remove('translate-y-4', 'opacity-0');
      link.classList.add('translate-y-0', 'opacity-100');
    });
  }

  function closeMobileMenu() {
    isMenuOpen = false;
    mobileMenu?.classList.add('opacity-0', 'pointer-events-none', '-translate-y-4');
    mobileMenu?.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
    
    iconBurger?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    
    document.body.style.overflow = ''; // Ripristina lo scroll del body

    // Resetta lo stato visivo dei link
    navLinks.forEach((link) => {
      link.classList.add('translate-y-4', 'opacity-0');
      link.classList.remove('translate-y-0', 'opacity-100');
    });
  }

  // Toggle al click sul bottone Burger
  menuBtn?.addEventListener('click', () => {
    if (isMenuOpen) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  });

  // Chiude il menu quando si clicca su qualsiasi link
  navLinks.forEach((link) => {
    link.addEventListener('click', () => {
      closeMobileMenu();
    });
  });
</script>