---
// src/components/Header.astro
const menuLinks = [
  { text: "Home", href: "#home" },
  { text: "Chi Siamo", href: "#chi-siamo" },
  { text: "Servizi", href: "#servizi" },
  { text: "Fondi & Investitori", href: "#investitori" },
  { text: "FAQ", href: "#faq" },
];
---

<header id="main-header" class="fixed top-0 left-0 w-full z-50 px-6 sm:px-10 lg:px-14 font-['Inter'] transition-all duration-300 ease-in-out pt-[10px]">
  <div id="header-inner" class="max-w-7xl mx-auto h-20 flex items-center justify-between border-b border-white/10 transition-all duration-300">
    
    <a href="#home" class="flex items-center gap-2 group shrink-0">
      <span class="w-9 h-9 bg-lime-400 rounded-lg flex items-center justify-center text-slate-950 font-black text-lg transition-transform group-hover:scale-105">E</span>
      <span class="text-lg font-bold tracking-tight text-white">EDIL<span class="text-lime-400 font-extrabold">PARTNER</span></span>
    </a>

    <nav class="hidden md:flex items-center gap-6 lg:gap-8">
      {menuLinks.map(link => (
        <a 
          href={link.href} 
          class="text-xs font-bold uppercase tracking-wider text-white/90 hover:text-lime-400 transition-colors py-2"
        >
          {link.text}
        </a>
      ))}
    </nav>

    <div class="hidden md:flex shrink-0">
      <a 
        href="#contatti" 
        class="inline-flex items-center justify-center px-6 py-2.5 rounded-full text-xs font-bold bg-lime-400 text-slate-950 hover:bg-lime-300 shadow-sm transition-all hover:-translate-y-0.5"
      >
        Get In Touch
      </a>
    </div>

    <button id="menu-btn" class="md:hidden p-2 text-white hover:text-lime-400 focus:outline-none transition-colors" aria-label="Apri Menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  <!-- Mobile menu coordinato con bg-slate-900 del Footer e dell'About -->
  <div id="mobile-menu" class="hidden md:hidden absolute top-20 left-[10px] right-[10px] bg-slate-900/95 backdrop-blur-md rounded-2xl border border-white/10 shadow-2xl p-6 space-y-4">
    {menuLinks.map(link => (
      <a 
        href={link.href} 
        class="block text-sm font-bold uppercase tracking-wider text-white hover:text-lime-400 py-2 border-b border-white/5 last:border-0"
      >
        {link.text}
      </a>
    ))}
    <a 
      href="#contatti" 
      class="block text-center w-full bg-lime-400 text-slate-950 font-bold py-3 rounded-full text-xs uppercase tracking-wider shadow-md"
    >
      Get In Touch
    </a>
  </div>
</header>

<script>
  const header = document.getElementById('main-header');
  const innerContainer = document.getElementById('header-inner');
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  let lastScrollY = window.scrollY;

  window.addEventListener('scroll', () => {
    if (!header || !innerContainer) return;

    const currentScrollY = window.scrollY;

    // Sfondo dinamico impostato su bg-slate-900/95 (uguale al tuo Footer)
    if (currentScrollY > 50) {
      header.classList.remove('pt-[10px]');
      header.classList.add('bg-slate-900/95', 'backdrop-blur-md', 'shadow-md');
      innerContainer.classList.remove('border-b', 'border-white/10', 'h-20');
      innerContainer.classList.add('h-16');
    } else {
      header.classList.add('pt-[10px]');
      header.classList.remove('bg-slate-900/95', 'backdrop-blur-md', 'shadow-md');
      innerContainer.classList.add('border-b', 'border-white/10', 'h-20');
      innerContainer.classList.remove('h-16');
    }

    if (currentScrollY > lastScrollY && currentScrollY > 400) {
      header.classList.add('-translate-y-full');
    } else {
      header.classList.remove('-translate-y-full');
    }

    lastScrollY = currentScrollY;
  });

  // Mobile Menu Toggle
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }
</script>