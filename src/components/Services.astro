---

<section id="servizi" class="fade-in-up delay-300 py-20 lg:py-24 bg-white font-['Inter'] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header Sezione -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold bg-orange-100 text-orange-700 uppercase tracking-wider mb-4 border border-orange-200">
        I Nostri Servizi
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4 leading-tight">
        Soluzioni Complete per la <span class="text-orange-600 font-black">Casa e l'Edilizia</span>
      </h2>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        Vega Costruzioni mette a disposizione personale specializzato e materiali a norma di sicurezza per garantire il miglior rapporto qualità/prezzo a Verona e provincia.
      </p>
    </div>

    <!-- Griglia Servizi -->
    <div class="fade-in-up grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {services.map((service) => (
        <div class="bg-slate-50 border border-slate-200/80 p-8 rounded-[1.75rem] flex flex-col justify-between hover:bg-white hover:shadow-xl hover:border-orange-200 group transition-all duration-300">
          
          <div>
            <div class="w-12 h-12 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center shrink-0 shadow-sm mb-6 group-hover:scale-110 group-hover:bg-orange-600 group-hover:text-white transition-all duration-300">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.icon} />
              </svg>
            </div>
            
            <h3 class="text-xl font-extrabold text-slate-900 mb-3 tracking-tight group-hover:text-orange-600 transition-colors">
              {service.title}
            </h3>
            
            <p class="text-sm text-slate-600 leading-relaxed mb-8">
              {service.description}
            </p>
          </div>

          <div class="border-t border-slate-200/60 pt-4">
            <a 
              href="#contatti" 
              class="text-xs sm:text-sm font-bold tracking-wide text-slate-800 inline-flex items-center gap-2 group-hover:text-orange-600 transition-colors"
            >
              <span>Richiedi Informazioni</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>