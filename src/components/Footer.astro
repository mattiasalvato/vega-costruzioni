---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();

const footerLinks = {
  azienda: [
    { text: "Chi Siamo", href: "#chi-siamo" },
    { text: "Perché Sceglierci", href: "#why-choose-us" },
    { text: "Testimonianze", href: "#testimonianze" },
    { text: "Domande Frequenti", href: "#faq" }
  ],
  servizi: [
    { text: "Ristrutturazioni Case & Appartamenti", href: "#servizi" },
    { text: "Ristrutturazione Bagni & Cucine", href: "#servizi" },
    { text: "Rifacimento Tetti & Facciate", href: "#servizi" },
    { text: "Cappotti Termici & Isolamento", href: "#servizi" },
    { text: "Scavi & Impianti Fognari", href: "#servizi" }
  ]
};
---

<footer id="footer" class="w-full px-[10px] pb-[10px] bg-slate-100 font-['Inter']">
  
  <div class="relative w-full rounded-2xl overflow-hidden bg-blue-950 border-4 border-white shadow-2xl pt-16 pb-8 px-6 sm:px-12 lg:px-16">
    
    <!-- Pattern di sfondo grigliato -->
    <div class="absolute inset-0 bg-[radial-gradient(#ea580c_1px,transparent_1px)] [background-size:24px_24px] opacity-[0.03] z-0 pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 pb-12 border-b border-white/10">
        
        <!-- Colonna 1: Brand e Presentazione (5 Colonne) -->
        <div class="lg:col-span-5 space-y-5">
          <a href="#home" class="flex items-center gap-2.5 group inline-block">
            <span class="w-9 h-9 bg-orange-600 rounded-lg flex items-center justify-center text-white font-black text-lg transition-transform group-hover:scale-105 shadow-md shadow-orange-600/30">V</span>
            <span class="text-lg font-bold tracking-tight text-white uppercase">VEGA <span class="text-orange-500 font-extrabold">COSTRUZIONI</span></span>
          </a>
          <p class="text-slate-300 text-sm leading-relaxed max-w-sm">
            Impresa edile specializzata in ristrutturazioni e costruzioni chiavi in mano a Verona e provincia. Un'unica direzione dei lavori per garantirti risparmio, tempi certi e materiali di qualità.
          </p>
          
          <!-- Contatti Rapidi -->
          <div class="pt-2 space-y-1.5 text-xs text-slate-300">
            <p class="flex items-center gap-2">
              <strong class="text-orange-400 font-semibold">Tel:</strong>
              <a href="tel:0452220703" class="hover:text-white transition-colors">+39 045 2220703</a> | 
              <a href="tel:3298990317" class="hover:text-white transition-colors">+39 329 8990317</a>
            </p>
            <p class="flex items-center gap-2">
              <strong class="text-orange-400 font-semibold">Email:</strong>
              <a href="mailto:info@ristrutturazioniveronaok.it" class="hover:text-white transition-colors">info@ristrutturazioniveronaok.it</a>
            </p>
          </div>
        </div>

        <!-- Colonna 2: Azienda (2 Colonne) -->
        <div class="lg:col-span-2 lg:pl-4">
          <h4 class="text-xs font-bold uppercase tracking-wider text-orange-400 mb-4">Azienda</h4>
          <ul class="space-y-2.5 text-xs sm:text-sm">
            {footerLinks.azienda.map(link => (
              <li>
                <a href={link.href} class="text-slate-400 hover:text-white transition-colors">{link.text}</a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Colonna 3: Servizi Core (2 Colonne) -->
        <div class="lg:col-span-2">
          <h4 class="text-xs font-bold uppercase tracking-wider text-orange-400 mb-4">Servizi Core</h4>
          <ul class="space-y-2.5 text-xs sm:text-sm">
            {footerLinks.servizi.map(link => (
              <li>
                <a href={link.href} class="text-slate-400 hover:text-white transition-colors">{link.text}</a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Colonna 4: Note Legali & Sede Legale (3 Colonne) -->
        <div class="lg:col-span-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-orange-400 mb-4">Note Legali & Sede</h4>
          <div class="text-slate-300 text-xs sm:text-sm leading-relaxed font-medium">
            <strong class="text-white font-extrabold block mb-1">Cooperativa VEGA costruzioni</strong>
            <p class="text-slate-400 text-xs mb-2">Società cooperativa a R.L.</p>
            <p class="text-slate-300">Via La Valle 2</p>
            <p class="text-slate-300">37135 Verona (VR)</p>
            
            <div class="text-slate-400 pt-3 text-[11px] font-mono border-t border-white/10 mt-3 space-y-0.5">
              <p>C.F. / P.IVA: 04259570234</p>
              <p>Ristrutturazioni chiavi in mano Verona</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Copyright e Informativa Legale -->
      <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] font-medium text-slate-400 tracking-wide">
        <p>&copy; {currentYear} Cooperativa VEGA costruzioni - Tutti i diritti riservati.</p>
        <div class="flex gap-6">
          <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
          <a href="#" class="hover:text-white transition-colors">Cookie Policy</a>
        </div>
      </div>

    </div>

  </div>
</footer>